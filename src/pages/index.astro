---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorIsland from '../components/CalculatorIsland.tsx';
---

<BaseLayout title="Kalkulator Google Skills Arcade Fasilitator">
  <main class="page">
    <section class="hero">
      <div>
        <p class="eyebrow">Sistem Poin</p>
        <h1>Kalkulator Milestone Google Skills Arcade Fasilitator</h1>
        <p class="intro">
          Hitung progres Arcade Games, Badge Keahlian, Bonus Points, dan milestone tertinggi berdasarkan aturan Sistem Poin.
        </p>
      </div>
      <aside class="notice">
        <strong>Catatan hadiah</strong>
        <span>Mencapai milestone fasilitator tidak otomatis menjamin hadiah atau swag.</span>
      </aside>
    </section>

    <section class="calculator" aria-label="Form kalkulator poin">
      <CalculatorIsland client:load />
    </section>

    <section class="panel table-panel" aria-label="Tabel milestone resmi">
      <div class="section-heading">
        <h2>Tingkatan Milestone</h2>
        <p>Milestone valid hanya jika syarat Arcade Games dan Badge Keahlian terpenuhi bersamaan.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Milestone</th>
              <th>Arcade Games</th>
              <th>Badge Keahlian</th>
              <th>Arcade Points dasar</th>
              <th>Bonus Milestone</th>
              <th>Total + Bonus</th>
            </tr>
          </thead>
          <tbody id="milestone-table"></tbody>
        </table>
      </div>
    </section>

    <section class="warnings" aria-label="Peringatan aturan">
      <h2>Peringatan Aturan</h2>
      <ul id="warning-list"></ul>
    </section>
  </main>

  <script>
    import { MILESTONES, WARNING_MESSAGES } from '../lib/milestones';
    
    function renderMilestoneTable() {
      const tableBody = document.getElementById('milestone-table');
      if (!tableBody) return;
      
      tableBody.innerHTML = MILESTONES.map(
        (milestone) => `
          <tr>
            <td><strong>${milestone.name}</strong></td>
            <td>${milestone.requirements.arcade_games}</td>
            <td>${milestone.requirements.skill_badges}</td>
            <td>${milestone.points.total_arcade_points}</td>
            <td>${milestone.points.bonus_points} + ${milestone.bonus_milestone.extra_bonus_points} opsional</td>
            <td>${milestone.points.total_with_bonus_points} / ${milestone.bonus_milestone.total_with_bonus_milestone}</td>
          </tr>
        `
      ).join('');
    }
    
    function renderWarnings() {
      const warningList = document.getElementById('warning-list');
      if (!warningList) return;
      warningList.innerHTML = WARNING_MESSAGES.map((message) => `<li>${message}</li>`).join('');
    }
    
    document.addEventListener('DOMContentLoaded', () => {
      renderMilestoneTable();
      renderWarnings();
    });
  </script>
</BaseLayout>
